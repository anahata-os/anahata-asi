<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>uno.anahata</groupId>
        <artifactId>anahata-asi-parent</artifactId>
        <version>1.2.12-SNAPSHOT</version>
    </parent>
    
    <artifactId>anahata-asi-intellij</artifactId>
    <packaging>jar</packaging>
    <name>Anahata ASI Sudio - IntelliJ</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <intellij.platform.version>262.10315.125</intellij.platform.version>
        <intellij.plugins.version>${intellij.platform.version}</intellij.plugins.version>
        <maven.compiler.showDeprecation>true</maven.compiler.showDeprecation>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>anahata-asi-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>anahata-asi-swing</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        
        <!-- IntelliJ IDEA Platform Modular Dependencies -->
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>ide</artifactId>
            <version>${intellij.platform.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>ide-impl</artifactId>
            <version>${intellij.platform.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Platform JCEF API (JBCefBrowser, JBCefApp) for HTML5 video playback -->
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>ui-jcef</artifactId>
            <version>${intellij.platform.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>core</artifactId>
            <version>${intellij.platform.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>core-impl</artifactId>
            <version>${intellij.platform.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>project-model</artifactId>
            <version>${intellij.platform.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>editor</artifactId>
            <version>${intellij.plugins.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.java</groupId>
            <artifactId>java-psi</artifactId>
            <version>${intellij.plugins.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.java</groupId>
            <artifactId>java-impl</artifactId>
            <version>${intellij.plugins.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Java refactoring processors (PullUp/PushDown/ChangeSignature/Inline/ExtractSuperclass). -->
        <dependency>
            <groupId>com.jetbrains.intellij.java</groupId>
            <artifactId>java-impl-refactorings</artifactId>
            <version>${intellij.plugins.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Bundled Maven plugin API (MavenProjectsManager, MavenRunner, ...).
        Transitives are excluded: many (packagesearch, ai.grazie.*) are unpublished
        internal JetBrains artifacts. Scope is provided, so the real classes are
        supplied by the running IDE; only the API surface is needed to compile. -->
        <dependency>
            <groupId>com.jetbrains.intellij.maven</groupId>
            <artifactId>maven</artifactId>
            <version>${intellij.plugins.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Maven domain model (MavenId). -->
        <dependency>
            <groupId>com.jetbrains.intellij.maven</groupId>
            <artifactId>maven-model</artifactId>
            <version>${intellij.plugins.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Maven server model (MavenArtifact and resolved-dependency types). -->
        <dependency>
            <groupId>com.jetbrains.intellij.maven</groupId>
            <artifactId>maven-server</artifactId>
            <version>${intellij.plugins.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Repository search model (MavenRepositoryArtifactInfo) for Maven index search. -->
        <dependency>
            <groupId>com.jetbrains.intellij.repository</groupId>
            <artifactId>repository-search-common</artifactId>
            <version>${intellij.plugins.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Bundled Terminal plugin API (TerminalToolWindowManager, ShellTerminalWidget). -->
        <dependency>
            <groupId>com.jetbrains.intellij.terminal</groupId>
            <artifactId>terminal</artifactId>
            <version>${intellij.plugins.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Platform SM test-runner API (SMTRunnerEventsListener/Adapter, SMTestProxy) and the
        base test-runner model (AbstractTestProxy) for structured test results. These are
        platform modules supplied by the running IDE, so no plugin <depends> is required. -->
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>sm-runner</artifactId>
            <version>${intellij.plugins.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>test-runner</artifactId>
            <version>${intellij.plugins.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- External-system framework (Gradle task execution via the provider-agnostic API).
        Platform modules supplied by the running IDE; Gradle dispatch needs the bundled
        Gradle plugin, declared in plugin.xml. -->
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>external-system</artifactId>
            <version>${intellij.plugins.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>external-system-impl</artifactId>
            <version>${intellij.plugins.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Platform XDebugger API (XDebuggerManager, XBreakpointManager, XDebugSession,
        XDebuggerEvaluator, frame/value model). A platform module supplied by the running IDE,
        so the Debugger toolkit needs no plugin <depends>: xdebugger lives in
        com.intellij.modules.platform and concrete line-breakpoint types are contributed by
        com.intellij.modules.java, both already declared. The toolkit uses only this
        provider-agnostic API, never the Java/Kotlin debugger implementations. -->
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>debugger</artifactId>
            <version>${intellij.plugins.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Unit tests (JUnit 5; versions managed by the parent). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <showDeprecation>true</showDeprecation>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <descriptors>
                        <descriptor>src/main/assembly/plugin-assembly.xml</descriptor>
                    </descriptors>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                IntelliJ Studio Javadoc Plugin Configuration:
                1. Single Source of Truth for Stylesheet: Resolves anahata-barca-theme.css from the parent
                   root using ${project.parent.basedir}/src/main/javadoc without duplicating CSS files.
                2. Offline Cross-Linking to Core Platform: Uses offlineLinks to read element-list generated
                   by the preceding Core aggregate build in target/reports/apidocs. In the browser, all Core
                   and Swing types (Agi, ToolContext, AgiPanel) render as active, clickable Barça-gold links
                   pointing directly to the Core Javadoc portal (../apidocs/) without network dependencies.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <javadocDirectory>${project.parent.basedir}/src/main/javadoc</javadocDirectory>
                    <addStylesheets>
                        <addStylesheet>anahata-barca-theme.css</addStylesheet>
                    </addStylesheets>
                    <offlineLinks>
                        <offlineLink>
                            <url>../apidocs/</url>
                            <location>${maven.multiModuleProjectDirectory}/target/reports/apidocs</location>
                        </offlineLink>
                    </offlineLinks>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>intellij-repository</id>
            <url>https://www.jetbrains.com/intellij-repository/releases</url>
        </repository>
        <repository>
            <id>jetbrains-dependencies</id>
            <url>https://cache-redirector.jetbrains.com/intellij-dependencies</url>
        </repository>
    </repositories>
</project>
